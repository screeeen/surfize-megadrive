{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SGDK: build",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "SGDK: clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "SGDK: run in BlastEm",
            "type": "shell",
            // -r E fuerza region PAL: el port esta calculado para 320x240 a 50 Hz
            // (ver docs/PORT_AUDIT_GML.md). En NTSC se recorta el campo y corre un 20% rapido.
            "command": "blastem -r E out/rom.bin",
            "problemMatcher": [],
            "dependsOn": "SGDK: build"
        }
    ]
}
